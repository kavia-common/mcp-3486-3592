# Application
APP_NAME="MCP Server"
APP_VERSION="0.1.0"
APP_DESCRIPTION="MCP Server provides message processing and JIRA integration."
CORS_ALLOW_ORIGINS="*"

# Security
JWT_SECRET_KEY="please-change-this"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database connection (preferred DSN)
# Example: postgresql+asyncpg://user:password@host:5432/mcp_db
DB_DSN="postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_db"

# Alternatively, specify discrete DB vars (used only if DB_DSN is empty)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="mcp_db"

# JIRA settings
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="user@example.com"
JIRA_API_TOKEN="your-api-token"
JIRA_CLOUD=true
