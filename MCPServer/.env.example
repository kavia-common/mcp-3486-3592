# App
APP_NAME=MCP Server
ENV=development
DEBUG=true
# Preserve preview port handling; default to 3001
PORT=3001

# CORS
# Comma-separated list, e.g., http://localhost:5173,http://localhost:3000
BACKEND_CORS_ORIGINS=*

# Database
# Formats:
# - postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mcp_db

# Auth / JWT
# IMPORTANT: Change JWT_SECRET_KEY in production!
JWT_SECRET_KEY=please-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JIRA integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# HTTP
REQUEST_TIMEOUT_SECONDS=30
